# ==============================================================================
# VARIÁVEIS DE AMBIENTE - KING'S GESTÃO (VERCEL + SUPABASE)
# ==============================================================================

# 1. Conexão PostgreSQL do Supabase (Recomendado para Vercel Serverless)
# No Supabase: Project Settings -> Database -> Connection string -> URI (Modo Transaction Pooler - Porta 6543)
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres"

# 2. Credenciais de API do Supabase (Opcional se usar DATABASE_URL)
# No Supabase: Project Settings -> API
SUPABASE_URL="https://[SEU-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 3. Configurações Locais
PORT=3001
